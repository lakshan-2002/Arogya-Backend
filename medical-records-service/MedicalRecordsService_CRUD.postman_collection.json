{
  "info": {
    "name": "Medical Records Service API - Complete CRUD",
    "description": "Complete CRUD API collection for Medical Records Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Test Result (No File)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {"key": "labTestId", "value": "{{lab_test_id}}", "type": "text"},
            {"key": "patientId", "value": "{{patient_id}}", "type": "text"},
            {"key": "technicianId", "value": "{{technician_id}}", "type": "text"},
            {"key": "testResultDescription", "value": "Blood test results show normal levels.", "type": "text"},
            {"key": "technicianNotes", "value": "Patient was cooperative during test", "type": "text"}
          ]
        },
        "url": {"raw": "{{base_url}}/test-results", "host": ["{{base_url}}"], "path": ["test-results"]}
      }
    },
    {
      "name": "Create Test Result (With File)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {"key": "labTestId", "value": "{{lab_test_id}}", "type": "text"},
            {"key": "patientId", "value": "{{patient_id}}", "type": "text"},
            {"key": "technicianId", "value": "{{technician_id}}", "type": "text"},
            {"key": "testResultDescription", "value": "X-Ray results attached. No abnormalities detected.", "type": "text"},
            {"key": "technicianNotes", "value": "Clear imaging obtained", "type": "text"},
            {"key": "file", "type": "file", "src": ""}
          ]
        },
        "url": {"raw": "{{base_url}}/test-results", "host": ["{{base_url}}"], "path": ["test-results"]}
      }
    },
    {
      "name": "Get All Test Results (Paginated)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/test-results?page=0&size=20&sortBy=createdAt&sortDir=DESC",
          "host": ["{{base_url}}"],
          "path": ["test-results"],
          "query": [
            {"key": "page", "value": "0"},
            {"key": "size", "value": "20"},
            {"key": "sortBy", "value": "createdAt"},
            {"key": "sortDir", "value": "DESC"}
          ]
        }
      }
    },
    {
      "name": "Get Test Result by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw": "{{base_url}}/test-results/{{test_result_id}}", "host": ["{{base_url}}"], "path": ["test-results", "{{test_result_id}}"]}
      }
    },
    {
      "name": "Get Test Result by Lab Test ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw": "{{base_url}}/test-results/lab-test/{{lab_test_id}}", "host": ["{{base_url}}"], "path": ["test-results", "lab-test", "{{lab_test_id}}"]}
      }
    },
    {
      "name": "Get Patient Test Results (List)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw": "{{base_url}}/test-results/patient/{{patient_id}}", "host": ["{{base_url}}"], "path": ["test-results", "patient", "{{patient_id}}"]}
      }
    },
    {
      "name": "Get Patient Test Results (Paginated)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/test-results/patient/{{patient_id}}/paged?page=0&size=10&sortBy=createdAt&sortDir=DESC",
          "host": ["{{base_url}}"],
          "path": ["test-results", "patient", "{{patient_id}}", "paged"],
          "query": [
            {"key": "page", "value": "0"},
            {"key": "size", "value": "10"},
            {"key": "sortBy", "value": "createdAt"},
            {"key": "sortDir", "value": "DESC"}
          ]
        }
      }
    },
    {
      "name": "Update Test Result (No File)",
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {"key": "testResultDescription", "value": "Updated test results - All parameters normal", "type": "text"},
            {"key": "technicianNotes", "value": "Updated notes - Rechecked values", "type": "text"}
          ]
        },
        "url": {"raw": "{{base_url}}/test-results/{{test_result_id}}", "host": ["{{base_url}}"], "path": ["test-results", "{{test_result_id}}"]}
      }
    },
    {
      "name": "Update Test Result (With File)",
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {"key": "testResultDescription", "value": "Updated results with new file", "type": "text"},
            {"key": "technicianNotes", "value": "New file uploaded", "type": "text"},
            {"key": "file", "type": "file", "src": ""}
          ]
        },
        "url": {"raw": "{{base_url}}/test-results/{{test_result_id}}", "host": ["{{base_url}}"], "path": ["test-results", "{{test_result_id}}"]}
      }
    },
    {
      "name": "Delete Test Result",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {"raw": "{{base_url}}/test-results/{{test_result_id}}", "host": ["{{base_url}}"], "path": ["test-results", "{{test_result_id}}"]}
      }
    },
    {
      "name": "Download Test Result File",
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw": "{{base_url}}/test-results/{{test_result_id}}/download", "host": ["{{base_url}}"], "path": ["test-results", "{{test_result_id}}", "download"]}
      }
    }
  ]
}
